# ---------- Supabase (the self-hosted one, shared with Stub) ----------
NEXT_PUBLIC_SUPABASE_URL=https://db.example.org
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — bypasses RLS

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=https://refund.example.org
# Shared session across the suite (see src/lib/supabase/cookies.ts). Leave
# unset for local dev.
NEXT_PUBLIC_COOKIE_DOMAIN=.example.org
# Shared cookie name; must be the same in every app of the suite.
NEXT_PUBLIC_COOKIE_NAME=sb-suite
# Where Stub lives, for the "connect Gmail" link.
NEXT_PUBLIC_STUB_URL=https://stub.example.org
CRON_SECRET=

# ---------- Gmail (same Google client and token key as Stub) ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=               # MUST equal Stub's, or the shared Gmail tokens won't decrypt

# ---------- Price sources ----------
# https://serpapi.com — Google Flights + Google Hotels. 250 free searches/month.
SERPAPI_KEY=
# https://developer.bestbuy.com — free key, Products API by SKU.
BESTBUY_API_KEY=

# ---------- Web push ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com   # a real, monitored address: Apple rejects placeholders
