---
import BaseLayout from '../layouts/BaseLayout.astro';

const title       = `Poppers (Amyl Nitrite) Harm Reduction and Safety | Rave Wellness`;
const description = `Poppers (amyl nitrite, isobutyl nitrite, street names Rush, Jungle Juice, Liquid Gold, Locker Room, Amsterdam) can cause fatal methemoglobinemia if swallowed and severe hypotension combined with Viagra or Cialis. Evidence-based harm reduction guide.`;
const keywords    = `poppers harm reduction, amyl nitrite harm reduction, poppers safety guide, Rush poppers harm reduction, Jungle Juice poppers safety, Liquid Gold poppers harm reduction, Locker Room poppers safety, Amsterdam poppers, poppers Viagra danger, poppers Cialis danger, PDE5 inhibitor poppers interaction, poppers methemoglobinemia, poppers swallowing danger, isobutyl nitrite safety, isopropyl nitrite maculopathy, poppers eye damage, poppers retinal damage, alkyl nitrite harm reduction, poppers drug interactions, poppers rave harm reduction, nitrite harm reduction`;
const canonical   = `https://www.ravewellness.org/poppers.html`;
const ogTitle     = `Poppers (Amyl Nitrite) Harm Reduction, Rush, Jungle Juice Safety Guide | Rave Wellness`;
const ogDesc      = `Poppers (Rush, Jungle Juice, Amyl, Liquid Gold) cause fatal hypotension combined with Viagra/Cialis, and methemoglobinemia if swallowed. Evidence-based guide to safer use.`;
const twTitle     = ``;
const twDesc      = ``;
const schemaJson  = `{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "@id": "https://www.ravewellness.org/poppers.html#article",
        "headline": "Poppers (Amyl Nitrite) Harm Reduction: PDE5 Interaction, Swallowing Danger, and Safe Use",
        "description": "Evidence-based harm reduction for poppers (alkyl nitrites: amyl nitrite, isobutyl nitrite, isopropyl nitrite). Street names: Rush, Jungle Juice, Liquid Gold, Locker Room, Amsterdam, Bolt, TNT, Hardware, Ram, Kix. Covers PDE5 inhibitor interaction, methemoglobinemia from swallowing, maculopathy risk, and safe inhalation technique.",
        "url": "https://www.ravewellness.org/poppers.html",
        "author": { "@type": "Organization", "name": "Rave Wellness", "url": "https://www.ravewellness.org" },
        "publisher": { "@type": "Organization", "name": "Rave Wellness", "url": "https://www.ravewellness.org" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ravewellness.org/" },
          { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://www.ravewellness.org/#guides" },
          { "@type": "ListItem", "position": 3, "name": "Poppers", "item": "https://www.ravewellness.org/poppers.html" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Can you mix poppers with Viagra or Cialis?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No, combining poppers (alkyl nitrites) with PDE5 inhibitors (sildenafil/Viagra, tadalafil/Cialis, vardenafil/Levitra, avanafil/Stendra) is an absolute contraindication. Both cause vasodilation through different mechanisms: poppers by releasing nitric oxide and raising cGMP levels; PDE5 inhibitors by blocking the enzyme that degrades cGMP. Combined, they produce severe, potentially fatal hypotension (dangerously low blood pressure). This combination has caused deaths and is one of the most dangerous drug interactions involving poppers."
            }
          },
          {
            "@type": "Question",
            "name": "What happens if you swallow poppers?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Swallowing poppers is a medical emergency. Alkyl nitrites convert hemoglobin to methemoglobin, which cannot carry oxygen. Ingesting even a small amount can cause severe methemoglobinemia: rapid cyanosis (blue or grey discoloration of lips and fingertips), severe shortness of breath, dizziness, loss of consciousness, and potentially death. If someone swallows poppers, call emergency services immediately. The antidote, methylene blue, is only available in hospital settings. Poppers are designed exclusively for inhalation."
            }
          },
          {
            "@type": "Question",
            "name": "Do different types of poppers (amyl vs. isobutyl vs. isopropyl) have different risks?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Isopropyl nitrite, the most common formulation in the UK and parts of Europe following restrictions on amyl nitrite, has been specifically linked to poppers-associated maculopathy, a form of retinal damage causing central vision loss. Amyl nitrite and isobutyl nitrite have not been as clearly associated with maculopathy. If you use poppers regularly, avoiding products known or suspected to contain isopropyl nitrite reduces this risk. Most products do not label their exact formulation."
            }
          },
          {
            "@type": "Question",
            "name": "How should poppers be used safely?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Poppers are intended for brief inhalation only, hold the open bottle under one nostril and inhale for 1–3 seconds. Do not pour onto a cloth or inhale for extended periods. Do not use directly from the bottle with your nose touching the rim (contact dermatitis risk). Keep away from flames, poppers are highly flammable. Recap immediately after use. Store in a cool, dark place. If poppers contact skin, wash immediately with soap and water. Never swallow."
            }
