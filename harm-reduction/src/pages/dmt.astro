const description = `DMT harm reduction: why N,N-DMT and 5-MeO-DMT are not the same drug, the MAOI and SSRI danger behind ayahuasca, and what an Ehrlich purple really proves.`;
const keywords    = `DMT harm reduction, DMT safety, N,N-DMT, 5-MeO-DMT, 5-MeO-DMT vs DMT, DMT vs 5-MeO-DMT difference, ayahuasca safety, ayahuasca SSRI interaction, ayahuasca MAOI, pharmahuasca, DMT dose, smoked DMT duration, DMT breakthrough, DMT Ehrlich reagent, DMT testing, DMT reagent test, DMT serotonin syndrome, DMT sitter, changa, DMT legal status, DMT tolerance`;
const canonical   = `https://www.ravewellness.org/dmt.html`;
const ogTitle     = `DMT Harm Reduction: N,N vs 5-MeO, MAOI Risk & Testing | Rave Wellness`;
const ogDesc      = `Two different drugs share the name DMT. Here is how they differ, why the ayahuasca MAOI interaction is the real danger, and what a purple Ehrlich result actually proves.`;
const twTitle     = ``;
const twDesc      = ``;
const schemaJson  = `{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "@id": "https://www.ravewellness.org/dmt.html#article",
        "headline": "DMT Harm Reduction: N,N-DMT vs 5-MeO-DMT, MAOI Interactions, and Testing",
        "description": "Evidence-based harm reduction for DMT, covering the difference between N,N-DMT and 5-MeO-DMT, the MAOI and SSRI interaction behind ayahuasca, physical safety during fast-onset smoked doses, reagent testing limits, and contraindications.",
        "url": "https://www.ravewellness.org/dmt.html",
        "author": { "@type": "Organization", "name": "Rave Wellness", "url": "https://www.ravewellness.org" },
        "publisher": { "@type": "Organization", "name": "Rave Wellness", "url": "https://www.ravewellness.org" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ravewellness.org/" },
          { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://www.ravewellness.org/#guides" },
          { "@type": "ListItem", "position": 3, "name": "DMT", "item": "https://www.ravewellness.org/dmt.html" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is 5-MeO-DMT the same thing as DMT?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. N,N-DMT and 5-MeO-DMT are two different compounds that share part of a name. 5-MeO-DMT is active at far smaller doses by weight, so a quantity that would be a modest N,N-DMT dose can be a very heavy 5-MeO-DMT dose. The effect profile is also different: N,N-DMT is strongly visual, while 5-MeO-DMT is usually described as overwhelming and non-visual. A forensic case report documents a death after 5-MeO-DMT was consumed in an ayahuasca-style preparation containing MAOI beta-carbolines. If you cannot confirm which one you have, do not dose. Ehrlich reagent turns purple for both and cannot separate them."
            }
          },
          {
            "@type": "Question",
            "name": "Why is DMT inactive when swallowed?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Monoamine oxidase in the gut and liver breaks down DMT before enough reaches the brain, so plain oral DMT produces little or no effect. Ayahuasca and pharmahuasca get around this by adding a monoamine oxidase inhibitor, usually harmala alkaloids from Banisteriopsis caapi or Syrian rue. Adding the MAOI is what makes the oral route work and is also what creates the serious interaction risk with SSRIs, SNRIs, MDMA, other serotonergic drugs, and tyramine-rich foods."
            }
          },
          {
            "@type": "Question",
            "name": "Can Ehrlich reagent confirm that a sample is DMT?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Only partially. Ehrlich reagent reacts with the indole ring and turns purple, so a purple result says the sample contains an indole. It does not say which indole. LSD, psilocybin, DMT, and 5-MeO-DMT all contain an indole ring and can all produce a purple Ehrlich result, so the test cannot separate N,N-DMT from 5-MeO-DMT. Treat Ehrlich as a screen that rules things out rather than a confirmation, and use a lab drug-checking service when the identity actually matters."
            }
          },
          {
            "@type": "Question",
            "name": "How long does smoked DMT last?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Vaporised or smoked N,N-DMT comes on within seconds, peaks at roughly one minute, and is largely over within about five to twenty minutes. Because the onset is faster than you can react to, sit or lie down before you take the first inhalation, hand the pipe to a sober sitter, and never dose standing up or near heat, water, or stairs."
            }
