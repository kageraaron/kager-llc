const keywords    = `cocaine harm reduction, coke harm reduction, coke drug safety, stimulant harm reduction, cocaine fentanyl test, levamisole cocaine, cocaine cardiovascular risk, cocaine effects body, cocaine safety guide, crack cocaine harm reduction, amphetamine harm reduction, methamphetamine harm reduction, cocaine drug interactions, MAOI cocaine, nasal rinse cocaine, cocaethylene alcohol cocaine, cocaine nose damage, cocaine heart risk, cocaine street names, coke drug, snow drug, blow drug, Charlie drug, white drug, lines cocaine, powder cocaine, nose candy, C drug, yayo, rail cocaine`;
