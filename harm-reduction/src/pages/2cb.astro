---
import BaseLayout from '../layouts/BaseLayout.astro';

const title       = `2C-B Harm Reduction: Safe Dosing, Testing & Nexus Flip Guide | Rave Wellness`;
const description = `2C-B (nexus, bees): correct reagent colors, oral vs. nasal dose differences, MAOI danger, nexus flip safety. Note: tusi/pink cocaine is usually not 2C-B.`;
const keywords    = `2C-B harm reduction, 2cb harm reduction guide, 2cb dose, 2cb effects, 2C-B drug, 2cb trip, 2C-B marquis test, 2C-B Mecke test, 2C-B festival safety, phenethylamine psychedelic, phenethylamine harm reduction, 2C-B combinations, nexus flip, nexus flip safety, 2C-B MDMA, 2cb reagent test, 2cb safe dose, 2cb psychedelic, 2C-B street names, nexus drug, bees drug, venus drug, tucibi drug, 2cb slang, pink cocaine vs 2cb, tusi vs 2cb, is pink cocaine 2cb, tucibi vs tusi`;
const canonical   = `https://www.ravewellness.org/2cb.html`;
const ogTitle     = `2C-B Harm Reduction: Safe Dosing, Testing & Nexus Flip Guide | Rave Wellness`;
const ogDesc      = `Reagent testing colors, oral vs. nasal dosing, MAOI contraindication, nexus flip safety, and dangerous combinations. The 2C-B harm reduction guide.`;
const twTitle     = ``;
const twDesc      = ``;
const schemaJson  = `{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "@id": "https://www.ravewellness.org/2cb.html#article",
        "headline": "2C-B Harm Reduction: Testing, Dosing, and Safer Use",
        "description": "Evidence-based harm reduction for 2C-B including correct reagent colors, oral and nasal dose ranges, set and setting, nexus flip guidance, and dangerous drug combinations.",
        "url": "https://www.ravewellness.org/2cb.html",
        "author": { "@type": "Organization", "name": "Rave Wellness", "url": "https://www.ravewellness.org" },
        "publisher": { "@type": "Organization", "name": "Rave Wellness", "url": "https://www.ravewellness.org" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ravewellness.org/" },
          { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://www.ravewellness.org/#guides" },
          { "@type": "ListItem", "position": 3, "name": "2C-B", "item": "https://www.ravewellness.org/2cb.html" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What color does 2C-B turn on the Marquis reagent?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "2C-B produces no reaction or a faint yellow/orange with Marquis, not purple. If Marquis turns purple or black, that indicates MDMA or a similar entactogen, not 2C-B. For confirmation, also use Mecke (blue-green) and Liebermann (olive-green to green). Simon's reagent shows no reaction for 2C-B, which helps distinguish it from MDMA and methamphetamine."
            }
          },
          {
            "@type": "Question",
            "name": "Is it safe to combine 2C-B with MDMA (nexus flip)?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "2C-B + MDMA (the 'nexus flip') is common but significantly increases cardiovascular load and overheating risk. If you choose to combine them, take MDMA first and add 2C-B at the peak of the MDMA (~90 min after). Use much lower doses of each than you would alone. The combined experience is significantly more intense than either substance alone, and the comedown and next-day recovery are harder."
            }
          },
          {
            "@type": "Question",
            "name": "Why are MAOIs dangerous with 2C-B?",
