      },
      [key('ghb','opioids')]: {
        severity: 'danger',
        label: 'DANGER, Respiratory arrest',
        title: 'GHB + Opioids',
        summary: 'All three major CNS depressant types, GABA agents (GHB), opioids, and benzodiazepines, synergize on respiratory depression. GHB + any opioid is extremely dangerous and linked to many overdose deaths.',
        mechanism: 'Opioids suppress respiratory drive via mu-receptor agonism in the brainstem. GHB adds GABA-B and GHB-receptor mediated depression. Combined, the respiratory drive can be completely abolished at doses that seem moderate individually.',
        advice: 'Do not combine GHB with opioids under any circumstances. If opioids may be involved, have naloxone (Narcan) immediately available, though it will not reverse GHB effects.',
        emergency: true
      },

      [key('tramadol','mdma')]: {
