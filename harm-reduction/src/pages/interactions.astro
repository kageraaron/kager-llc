---
import BaseLayout from '../layouts/BaseLayout.astro';

const title       = `Drug Interaction Checker, Is X Safe With Y? | Rave Wellness`;
const description = `Drug interaction checker: MDMA, opioids, LSD, ketamine, Viagra, alcohol, SSRIs, benzos, and more. Evidence-based risks and guidance for any combination.`;
const keywords    = `drug interaction checker, is mdma safe with antidepressants, mdma ssri interaction, lsd and lithium seizure, ketamine and alcohol dangerous, cocaethylene cocaine alcohol, mdma maoi serotonin syndrome, can you take shrooms on ssri, psychedelic drug interactions, candy flip mdma lsd, hippie flip mdma mushrooms, rave drug interactions, opioid drug interactions, viagra poppers dangerous, mescaline interactions, dmt maoi ayahuasca, nicotine mdma, multi-drug interactions`;
const canonical   = `https://www.ravewellness.org/interactions.html`;
const ogTitle     = `Drug Interaction Checker, Is X Safe With Y? | Rave Wellness`;
const ogDesc      = `Select any combination of substances to see interaction risks and harm reduction guidance. MDMA, LSD, opioids, Viagra, alcohol, SSRIs, MAOIs, and more.`;
const twTitle     = ``;
const twDesc      = ``;
const schemaJson  = `{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "@id": "https://www.ravewellness.org/interactions.html#tool",
        "name": "Drug Interaction Checker",
        "url": "https://www.ravewellness.org/interactions.html",
        "description": "Interactive tool to check interactions between common recreational substances and medications, with evidence-based harm reduction guidance.",
        "applicationCategory": "HealthApplication",
        "publisher": { "@type": "Organization", "name": "Rave Wellness", "url": "https://www.ravewellness.org" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ravewellness.org/" },
          { "@type": "ListItem", "position": 2, "name": "Drug Interaction Checker", "item": "https://www.ravewellness.org/interactions.html" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is MDMA safe to take with antidepressants (SSRIs/SNRIs)?",
            "acceptedAnswer": { "@type": "Answer", "text": "No. SSRIs block the transporter MDMA uses to release serotonin, which simultaneously reduces MDMA's effects and raises serotonin syndrome risk. People often redose to chase the blunted effect, dramatically increasing danger. Avoid this combination and discuss any planned changes to antidepressants with your doctor." }
          },
          {
            "@type": "Question",
            "name": "Is LSD dangerous with lithium?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes, multiple case reports document seizures and cardiac arrhythmia when LSD is combined with lithium. People on lithium for bipolar disorder must not use LSD or other serotonergic psychedelics." }
          },
          {
            "@type": "Question",
            "name": "Can you mix ketamine and alcohol?",
            "acceptedAnswer": { "@type": "Answer", "text": "This is high risk. Both are CNS depressants and combine to cause synergistic respiratory depression, breathing can slow to dangerous levels. This combination accounts for a significant proportion of ketamine-related harms. Avoid combining entirely." }
          },
          {
            "@type": "Question",
            "name": "Why is cocaine with alcohol dangerous?",
            "acceptedAnswer": { "@type": "Answer", "text": "The liver converts cocaine and alcohol together into cocaethylene, a compound more cardiotoxic and longer-lasting than cocaine alone. This is one of the most common drug combinations in cardiovascular drug-related deaths." }
          },
          {
            "@type": "Question",
            "name": "Can you take psilocybin (shrooms) if you're on SSRIs or have anxiety?",
            "acceptedAnswer": { "@type": "Answer", "text": "SSRIs blunt psilocybin effects significantly through 5-HT2A receptor downregulation. Expect reduced or no effects, do not escalate dose to compensate. If you have anxiety, psilocybin can intensify it; ensure a safe setting, low dose, and a trusted sober sitter." }
          },
          {
            "@type": "Question",
            "name": "Is it dangerous to mix MDMA with MAOIs?",
            "acceptedAnswer": { "@type": "Answer", "text": "This combination can be fatal. MAOIs block serotonin breakdown while MDMA triggers a massive serotonin flood, the result is potentially lethal serotonin syndrome. Do not combine under any circumstances." }
          },
          {
            "@type": "Question",
            "name": "What is a candy flip (MDMA + LSD)?",
            "acceptedAnswer": { "@type": "Answer", "text": "A candy flip combines MDMA and LSD. The total experience lasts 12–18 hours due to LSD's duration. Combined serotonin load increases neurotoxicity risk. If attempting: take MDMA 3–4 hours into the LSD experience, keep MDMA at 75mg or less, and allow at least double the normal recovery time between sessions." }
          },
          {
            "@type": "Question",
            "name": "Is psilocybin dangerous with lithium?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes. Like LSD, psilocybin combined with lithium has documented risk of seizures and cardiac events. People on lithium must not use psilocybin." }
          },
          {
            "@type": "Question",
            "name": "Can benzodiazepines stop a bad trip?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes, benzodiazepines (diazepam, lorazepam, alprazolam) reliably reduce psychedelic intensity and are the recommended intervention for overwhelming LSD or psilocybin experiences. They blunt but don't fully eliminate the experience. Diazepam 10–20mg is commonly used. Do not combine benzos recreationally, keep them as a safety tool." }
          }
        ]
      }
    ]
  }`;
