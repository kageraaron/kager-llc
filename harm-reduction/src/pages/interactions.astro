    const selected = [];
    const tiles = document.querySelectorAll('.substance-tile');
    const statusEl = document.getElementById('checkerStatus');
    const resultEl = document.getElementById('interaction-result');

    function buildCardHTML(a, b) {
      var k = key(a, b);
      var data = INTERACTIONS[k];
      var sevClass, badgeText, title, summary, mechanism, advice, emergency;

      if (!data) {
        sevClass = 'sev-unknown';
        badgeText = 'No specific data';
        title = SUBSTANCES[a] + ' + ' + SUBSTANCES[b];
        summary = "No specific interaction data exists for this combination. This does not mean it is safe — it means it has not been well-studied or documented. Research each substance using TripSit's combo chart and Erowid before combining.";
        mechanism = 'Unknown — insufficient data.';
        advice = 'Treat as potentially risky until you have researched both substances thoroughly. When in doubt, do not combine.';
        emergency = false;
      } else {
        sevClass = 'sev-' + data.severity;
        badgeText = data.label;
        title = data.title;
        summary = data.summary;
        mechanism = data.mechanism;
        advice = data.advice;
        emergency = data.emergency;
      }

      var emergencyHTML = emergency
        ? '<div class="emergency-box">🚨 If someone is experiencing symptoms, seizures, loss of consciousness, difficulty breathing, extreme agitation, or rapid/irregular heart rate, call emergency services immediately.</div>'
        : '';

      return '<div class="interaction-card ' + sevClass + '">'
        + '<span class="sev-badge">' + badgeText + '</span>'
        + '<h2>' + title + '</h2>'
        + '<div class="ic-section"><div class="ic-label">Summary</div><p>' + summary + '</p></div>'
        + '<div class="ic-section"><div class="ic-label">Mechanism</div><p>' + mechanism + '</p></div>'
        + '<div class="ic-section"><div class="ic-label">Harm Reduction</div><p>' + advice + '</p></div>'
        + emergencyHTML
        + '</div>';
    }

    function showAllInteractions() {
      if (selected.length < 2) {
        resultEl.classList.remove('visible');
        resultEl.innerHTML = '';
        return;
      }
      var html = '';
      for (var i = 0; i < selected.length; i++) {
        for (var j = i + 1; j < selected.length; j++) {
          html += buildCardHTML(selected[i], selected[j]);
        }
      }
      resultEl.innerHTML = html;
      resultEl.classList.add('visible');
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function updateStatus() {
      if (selected.length === 0) {
        statusEl.innerHTML = '<span>Select two or more substances above</span>';
        return;
      }
      var pills = selected.map(function(id) {
        return '<span class="sel-pill">' + SUBSTANCES[id] + '</span>';
      }).join(' <span class="sel-plus">+</span> ');
      var suffix = selected.length === 1 ? ' <span>+ select one more</span>' : '';
      statusEl.innerHTML = pills + suffix + ' <button class="clear-btn" id="clearBtn">Clear</button>';
      document.getElementById('clearBtn').addEventListener('click', clearAll);
    }

    function clearAll() {
      selected.length = 0;
      tiles.forEach(function(t) { t.classList.remove('selected'); });
      resultEl.classList.remove('visible');
      resultEl.innerHTML = '';
      updateStatus();
    }

    tiles.forEach(function(tile) {
      tile.addEventListener('click', function() {
        var id = tile.dataset.id;
        var idx = selected.indexOf(id);

        if (idx !== -1) {
          selected.splice(idx, 1);
          tile.classList.remove('selected');
        } else {
          selected.push(id);
          tile.classList.add('selected');
        }

        updateStatus();
        showAllInteractions();
      });
    });

    updateStatus();
})();
</script>

</BaseLayout>

<style is:global>
  .substance-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 10px;
    max-width: 900px;
    margin: 0 auto 16px;
  }
  .substance-tile {
    background: var(--bg-card);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 14px 8px 12px;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.18s, background 0.18s, transform 0.12s;
    user-select: none;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    line-height: 1.2;
  }
  .substance-tile:hover {
    border-color: var(--purple);
    background: var(--bg-card-hover);
    color: var(--text);
    transform: translateY(-1px);
  }
  .substance-tile.selected {
    background: var(--purple-dim);
    border-color: var(--purple);
    color: var(--text);
  }
  .substance-tile .tile-emoji {
    display: block;
    font-size: 1.5rem;
    margin-bottom: 6px;
  }
  .substance-tile .tile-aka {
    display: block;
    font-size: 0.68rem;
    color: var(--text-dim);
    margin-top: 3px;
    font-weight: 400;
  }

  .checker-status {
    max-width: 900px;
    margin: 0 auto 32px;
    text-align: center;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .checker-status .sel-pill {
    background: var(--purple-dim);
    border: 1px solid var(--purple);
    border-radius: 20px;
    padding: 5px 16px;
    font-weight: 600;
    color: var(--text);
    font-size: 0.88rem;
