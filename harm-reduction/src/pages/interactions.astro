      },
      [key('nicotine','cocaine')]: {
        severity: 'moderate',
        label: 'MODERATE, Compounded vasoconstriction',
        title: 'Nicotine + Cocaine',
        summary: 'Both cocaine and nicotine cause vasoconstriction. Combined, coronary artery constriction risk is elevated. Cocaine-induced coronary spasm plus nicotine-induced vasoconstriction raises cardiac event risk, particularly in people with underlying cardiovascular sensitivity.',
        mechanism: 'Cocaine blocks norepinephrine reuptake, causing alpha-adrenergic vasoconstriction and coronary spasm. Nicotine independently triggers catecholamine release and peripheral vasoconstriction. Additive vasoconstrictive and cardiac burden is higher than either alone.',
        advice: 'Avoid heavy nicotine use alongside cocaine. Be attentive to chest discomfort, jaw pain, or shortness of breath — these warrant stopping both and seeking medical assessment.',
        emergency: false
      },
      [key('nicotine','amphetamine')]: {
