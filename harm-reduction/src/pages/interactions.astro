      [key('mdma','ketamine')]: {
        severity: 'moderate',
        label: 'MODERATE, Cardiovascular strain & dissociation',
        title: 'MDMA + Ketamine ("Kitty Flip")',
        summary: 'Intentional combination used for combined entactogenic and dissociative effects. The main risks are additive cardiovascular strain and the difficulty of managing a difficult experience while dissociated.',
        mechanism: 'MDMA raises heart rate, blood pressure, and body temperature via serotonin/dopamine/norepinephrine release. Ketamine independently elevates blood pressure through sympathomimetic effects. Combined cardiovascular burden is noteworthy.',
