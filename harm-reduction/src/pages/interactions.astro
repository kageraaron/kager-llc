      [key('lsd','lithium')]: {
        severity: 'danger',
        label: 'DANGER, Seizure risk',
        title: 'LSD + Lithium',
        summary: 'Multiple clinical case reports document seizures and cardiac arrhythmia. A 2021 analysis of online experience reports found 47% of 62 lithium+psychedelic reports involved seizures, versus 0% in 34 lamotrigine reports <a href="https://pubmed.ncbi.nlm.nih.gov/34348413/" target="_blank" rel="noopener" class="supp-link">[PMID 34348413]</a>. A 2024 adolescent case report documents 3 generalized seizures within 30 minutes of LSD ingestion at sub-therapeutic lithium levels <a href="https://pubmed.ncbi.nlm.nih.gov/38986146/" target="_blank" rel="noopener" class="supp-link">[PMID 38986146]</a>.',
        mechanism: 'The exact mechanism is unclear but likely involves lithium lowering seizure threshold and disrupting its own narrow therapeutic window. Psychedelics may alter lithium serum concentrations unpredictably.',
        advice: 'Do not combine under any circumstances. This is one of the most dangerous drug-drug interactions in the psychedelic space. If on lithium, psychedelics are contraindicated.',
        emergency: true
