---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Server-rendered contents list. h2 only: h3s make the list noisy and the
// posts are short enough that h2 is the useful granularity. Astro generates
// the heading slugs already, so these anchors work without extra plugins.
const toc = headings.filter(h => h.depth === 2 && h.slug !== 'quick-answers');

const canonical = `https://www.ravewellness.org/blog/${post.id}.html`;

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${canonical}#article`,
      "headline": post.data.title,
      "description": post.data.description,
      "datePublished": post.data.date.toISOString(),
      "dateModified": (post.data.lastmod ?? post.data.date).toISOString(),
      "url": canonical,
      "image": "https://www.ravewellness.org/android-chrome-512x512.png",
      "about": (post.data.tags ?? []).map(t => ({ "@type": "Thing", "name": t })),
      "keywords": (post.data.tags ?? []).join(", "),
      "author": post.data.author === 'Jordan Mercer'
        ? { "@type": "Person", "@id": "https://www.ravewellness.org/author/jordan-mercer.html#person", "name": "Jordan Mercer", "url": "https://www.ravewellness.org/author/jordan-mercer.html" }
        : { "@type": "Organization", "name": "Rave Wellness", "url": "https://www.ravewellness.org" },
      "publisher": {
        "@type": "Organization",
        "name": "Rave Wellness",
        "url": "https://www.ravewellness.org",
        "logo": { "@type": "ImageObject", "url": "https://www.ravewellness.org/android-chrome-512x512.png" }
      },
      "isPartOf": { "@id": "https://www.ravewellness.org/blog.html#webpage" },
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonical }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ravewellness.org/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.ravewellness.org/blog/" },
        { "@type": "ListItem", "position": 3, "name": post.data.title, "item": canonical }
      ]
    }
  ]
});

// Append the brand suffix only when it keeps the rendered <title> within Bing's 70-char limit.
// Posts written to the blog skill's spec (frontmatter title <=54) keep the brand; longer ones drop it.
const withBrand = `${post.data.title} | Rave Wellness`;
const pageTitle = withBrand.length <= 70 ? withBrand : post.data.title;
---

<BaseLayout
  title={pageTitle}
  description={post.data.description}
  {canonical}
  {schemaJson}
>
  <Fragment slot="footer-nav">
    <h4>Blog</h4>
    <a href="/blog.html">All articles</a>
    <a href="/#guides">Drug guides</a>
    <a href="/interactions.html">Interaction checker</a>
  </Fragment>

  <main>
    <article>
      <section id="hero" style="padding-top: 72px; padding-bottom: 32px;">
        <div class="container">
          <div class="section-header" style="max-width: 760px; margin: 0 auto;">
            <a href="/blog.html" style="color: var(--text-muted); font-size: 0.85rem; text-decoration: none; display: inline-block; margin-bottom: 16px;">← All articles</a>
            <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px;">
              {post.data.tags?.map(tag => (
                <span class="research-tag tag-clinical">{tag}</span>
              ))}
            </div>
            <h1 style="font-size: clamp(1.6rem, 4vw, 2.4rem); line-height: 1.2;">{post.data.title}</h1>
            <p class="section-sub" style="margin-top: 12px;">{post.data.description}</p>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 12px;">
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
              {' · '}
              {post.data.author === 'Jordan Mercer'
                ? <a href="/author/jordan-mercer.html" style="color: inherit; text-decoration: none;">{post.data.author}</a>
                : post.data.author
              }
            </p>
          </div>
        </div>
      </section>

      <section style="padding-top: 36px; padding-bottom: 80px;">
        <div class="container">
          <div class="prose" style="max-width: 760px; margin: 0 auto;">
            <div class="blog-disclaimer">
              <strong>Not medical advice.</strong> This article is for harm reduction and educational purposes only. Nothing here is a recommendation to use any substance. If you are experiencing a medical emergency, call your local emergency services immediately. Some links may be affiliate links, and we earn a small commission at no cost to you.
            </div>
            {toc.length >= 3 && (
              <details class="post-toc">
                <summary>Contents</summary>
                <ul>
                  {toc.map(h => (
                    <li><a href={`#${h.slug}`}>{h.text}</a></li>
                  ))}
                </ul>
              </details>
            )}
            <Content />
          </div>
        </div>
      </section>
    </article>
  </main>
</BaseLayout>

<style is:global>
  .prose h2 { font-size: 1.4rem; font-weight: 700; margin: 2rem 0 0.75rem; color: var(--text); }
  .prose h3 { font-size: 1.15rem; font-weight: 600; margin: 1.5rem 0 0.5rem; color: var(--text); }
  .prose p { line-height: 1.75; color: var(--text-muted); margin-bottom: 1rem; }
  .prose a { color: var(--purple); text-decoration: underline; }
  .prose a:hover { color: var(--text); }
  .prose ul, .prose ol { padding-left: 1.5rem; margin-bottom: 1rem; color: var(--text-muted); }
  .prose li { line-height: 1.7; margin-bottom: 0.25rem; }
  .prose strong { color: var(--text); font-weight: 600; }
  .prose hr { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }
  .prose blockquote { border-left: 3px solid var(--purple); padding-left: 1rem; margin: 1.5rem 0; color: var(--text-muted); font-style: italic; }
  .prose code { background: var(--bg-card); padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
  .blog-disclaimer { background: color-mix(in srgb, var(--purple) 8%, transparent); border-left: 3px solid var(--purple); border-radius: 0 6px 6px 0; padding: 12px 16px; margin-bottom: 2rem; font-size: 0.875rem; color: var(--text-muted); line-height: 1.6; }
  .blog-disclaimer strong { color: var(--text); }
  .prose .kit-cta { background: color-mix(in srgb, var(--purple) 12%, transparent); border: 1px solid var(--purple); border-radius: 8px; padding: 16px 20px; margin: 2rem 0; font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; }
  .prose .kit-cta strong { color: var(--text); }
  .prose .kit-cta a { font-weight: 600; white-space: nowrap; }
</style>
