---
import BaseLayout from '../layouts/BaseLayout.astro';

const title       = `MDMA, Psychedelics and Overdose Harm Reduction FAQ | Rave Wellness`;
const description = `30+ harm reduction questions answered with citations. Does MDMA cause brain damage? Can you OD on shrooms? Will benzos stop a bad trip? Answers for MDMA, LSD, ketamine, overdose, and festival safety.`;
const keywords    = `how to use narcan, naloxone harm reduction, opioid overdose signs, xylazine tranq, k-hole ketamine, ketamine bladder, HPPD psychedelics, serotonin syndrome MDMA, MDMA FAQ, 3 month rule MDMA, how to test LSD, NBOMe LSD, candy flipping, bad trip support, festival drug testing, fentanyl test strips, Good Samaritan law overdose, does mdma cause brain damage, ecstasy brain damage myth, ricaurte retraction mdma, trip killer benzodiazepine, how to stop a bad trip fast, can you overdose on mushrooms, can you overdose on LSD, lsd psilocybin overdose, mixing mdma and cocaine dangerous, mdma cocaine combination, nitrous oxide B12 deficiency, whippets vitamin b12, laughing gas nerve damage, lsd psilocybin cross tolerance, psychedelic cross tolerance`;
const canonical   = `https://www.ravewellness.org/faq.html`;
const ogTitle     = `MDMA, Psychedelics and Overdose Harm Reduction FAQ | Rave Wellness`;
const ogDesc      = `MDMA, psychedelics, overdose response, festival safety, 30+ evidence-based answers with citations. Narcan use, serotonin syndrome, k-holes, HPPD, and drug testing.`;
const twTitle     = ``;
const twDesc      = ``;
const schemaJson  = `{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": "Rave and festival harm reduction FAQ",
        "description": "Answers about MDMA, psychedelics, festivals, drug checking, hydration, heat safety, PLUR, SSRIs, candy flipping, and trip support.",
        "url": "https://www.ravewellness.org/faq.html",
        "publisher": {
          "@type": "Organization",
          "name": "Rave Wellness",
          "url": "https://www.ravewellness.org"
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ravewellness.org/" },
          { "@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://www.ravewellness.org/faq.html" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How often is it safe to roll on MDMA?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The harm reduction gold standard is the 3-Month Rule: wait at least three months between MDMA uses to allow serotonin transporters (SERT) and receptors to fully recover. Research shows short intervals significantly increase the risk of long-term neurotoxicity and diminished effects. At an absolute minimum, wait 4–6 weeks, but 3 months is the safest recommended interval."
            }
          },
          {
            "@type": "Question",
            "name": "What are the best test kits for MDMA?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Use a triple-reagent approach: Marquis (should turn purple to black), Mecke (should turn blue to black), and Simon's (reacts blue for MDMA, clear for MDA). Always also use Fentanyl Test Strips, as fentanyl contamination in pressed pills is a lethal reality. Test kits are available from DanceSafe (dancesafe.org/shop)."
            }
          },
          {
            "@type": "Question",
            "name": "Can I take MDMA if I am on SSRIs?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Generally, no. SSRIs like Lexapro, Zoloft, or Prozac block the serotonin transporter that MDMA needs to work, rendering it mostly ineffective. More dangerously, this combination risks Serotonin Syndrome, which can be fatal. Never stop your prescription medication to roll without consulting your doctor, SSRI withdrawal can be severe."
            }
          },
          {
            "@type": "Question",
            "name": "How do I test LSD to make sure it isn't NBOMe?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Use Ehrlich Reagent (should turn purple, confirming an indole compound like LSD) and Hofmann Reagent (turns blue specifically for LSD). Remember: 'If it's bitter, it's a spitter.' Real LSD is tasteless; NBOMe compounds are very bitter and can cause mouth numbing. NBOMe can be lethal at high doses."
            }
          },
          {
            "@type": "Question",
            "name": "How long does an LSD trip last?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "An LSD experience typically lasts 8 to 12 hours, with peaks between hours 2 and 5. Some residual effects may persist longer. Because of this duration, set and setting are critical, ensure you are in a safe, comfortable environment with trusted people and no obligations for at least 24 hours."
            }
          },
          {
            "@type": "Question",
            "name": "What should I do if someone is having a bad trip?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Remind them the experience is temporary and they are safe. Change the environment, move to a different room, adjust music or lighting. Encourage slow, deep breathing. The Fireside Project (62-FIRESIDE / 623-473-7433) offers free, confidential peer support during or after a psychedelic experience. The Zendo Project also provides harm reduction support at festivals."
            }
          },
          {
            "@type": "Question",
            "name": "What is candy flipping?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Candy flipping is combining LSD and MDMA. To reduce risk: stagger doses by taking LSD first and MDMA 3–4 hours later to align the peaks; take lower doses of each since the compounds potentiate each other; stay well hydrated since the combined physical strain increases dehydration and hyperthermia risk."
            }
          },
          {
            "@type": "Question",
            "name": "Are drug test kits legal to bring to festivals?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Legality varies by jurisdiction, test kits can technically be considered paraphernalia in some areas. However, many festivals partner with organizations like DanceSafe to allow on-site testing because it saves lives. Check the specific festival's harm reduction policy. Many people use kits discreetly at campsites or hotels."
            }
          },
          {
            "@type": "Question",
            "name": "Where can I find legitimate scientific research on psychedelics and MDMA?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Reliable sources include: MAPS (maps.org) for MDMA clinical trial research; The Beckley Foundation (beckleyfoundation.org); Johns Hopkins Center for Psychedelic & Consciousness Research; and Erowid (erowid.org) for a comprehensive harm reduction database. All conduct or publish peer-reviewed research."
            }
          },
          {
            "@type": "Question",
            "name": "What is harm reduction at a rave?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Harm reduction is a set of practical strategies and ideas aimed at reducing negative consequences of drug use, without requiring abstinence. At raves it includes testing substances, using ear protection, managing temperature, calibrated hydration with electrolytes, buddy systems, and knowing when to seek medical help."
            }
          },
          {
            "@type": "Question",
            "name": "Why is fentanyl testing important for party drugs?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Fentanyl and potent analogs have been detected in stimulants, pressed pills, and powders sold as MDMA, cocaine, or ketamine. A dose measured in milligrams can be fatal. Fentanyl test strips and xylazine strips are standard community practice because appearance and taste cannot rule out contamination."
            }
          },
          {
            "@type": "Question",
            "name": "How should I hydrate at a festival safely?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Match fluid intake to sweat loss and always include electrolytes when dancing for hours. Plain water alone, especially with substances that affect ADH like MDMA, can dilute blood sodium and cause hyponatremia, a documented cause of death at events. Aim for modest steady intake with electrolyte packets rather than chugging."
            }
          },
          {
            "@type": "Question",
            "name": "What are warning signs of heat stroke at a rave?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Confusion, agitation, hot dry skin or profuse sweating, rapid heart rate, vomiting, seizures, or collapse. Overheating amplifies risk with many substances, move the person to a cool area, remove excess layers, apply cool cloths, and call emergency services promptly."
            }
          },
          {
            "@type": "Question",
            "name": "What does PLUR mean?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "PLUR stands for Peace, Love, Unity, and Respect, a core ethos in much of rave culture emphasizing mutual care on the dance floor. Practically, it maps to checking in on friends, sharing accurate harm reduction information, de-escalating conflicts, and helping people get medical care when needed."
            }
          },
          {
            "@type": "Question",
            "name": "Is mixing alcohol with MDMA or psychedelics dangerous?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, alcohol adds dehydration, impairs judgment, and increases stress on the heart and liver. With MDMA, cocaethylene-style risks also apply when combining alcohol and stimulants. Harm reduction guidance generally recommends choosing one class of substance for a session, not stacking unpredictably."
            }
          },
          {
            "@type": "Question",
            "name": "How do I recognize an opioid overdose?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Signs of opioid overdose: unresponsive (won't wake to a firm sternal rub), very slow or stopped breathing (less than one breath every 5 seconds), blue or gray lips and fingernails, pinpoint pupils, and gurgling throat sounds. If you see these after drug use, call 911 and administer naloxone immediately. Fentanyl can cause overdose in people who weren't knowingly using opioids, because it contaminates cocaine, pressed pills, and other substances."
            }
          },
          {
            "@type": "Question",
            "name": "How do I use Narcan (naloxone) nasal spray?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Call 911 immediately. Lay the person on their back with head tilted back. Insert the Narcan nozzle into one nostril and press the plunger firmly. Place them in the recovery position (on their side, top knee forward). If no response in 2–3 minutes, give the second dose in the other nostril. Stay with them, naloxone wears off in 30–90 minutes and fentanyl can outlast it, causing re-overdose. Naloxone cannot harm someone who hasn't taken opioids."
            }
          },
          {
            "@type": "Question",
            "name": "Where can I get naloxone for free?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "NEXT Distro (nextdistro.org/naloxone) mails free naloxone to most US states with no prescription. Major pharmacies including CVS, Walgreens, and Rite Aid carry Narcan OTC without a prescription since 2023. Many local harm reduction organizations distribute it free, find one at harmreduction.org. Amazon stocks both the branded Narcan 4mg (B0CDQMYP39, ~$45) and a lower-cost generic (B0CLT5H1TR, ~$30), both OTC without prescription."
            }
          },
          {
            "@type": "Question",
            "name": "What is xylazine (tranq) and why doesn't naloxone reverse it?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Xylazine is a veterinary sedative increasingly mixed with fentanyl and detected in cocaine and other substances. It is not an opioid, so naloxone has no effect on xylazine itself. Still give naloxone if opioids may be present, fentanyl is almost always co-present. Call 911 even if the person partially responds, since xylazine overdose requires emergency supportive care. Xylazine also causes severe skin wounds requiring medical attention."
            }
          },
          {
            "@type": "Question",
            "name": "What is a k-hole and is it dangerous?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A k-hole is a state of deep dissociation from high-dose ketamine, you become largely unaware of your environment, unable to move or speak coherently. The main dangers are physical: falls before full sedation, aspiration if you vomit, and respiratory depression when combined with CNS depressants. Safe practices include lying down before that level sets in, having a sober person present, and never combining with alcohol, benzos, or opioids."
            }
          },
          {
            "@type": "Question",
            "name": "Can ketamine damage your bladder?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Ketamine-induced uropathy is a documented risk of frequent heavy use. Norketamine (a metabolite) damages the urothelial lining, causing progressive scarring. Warning signs are urinary urgency, pain, increased frequency, and blood in the urine, treat these as a hard stop signal. Most harm reduction guidance recommends maximum once per month and abstinence if any symptoms appear."
            }
          },
          {
            "@type": "Question",
            "name": "What is serotonin syndrome?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Serotonin syndrome is a potentially life-threatening condition from excessive serotonergic activity, most often triggered by combining MDMA with MAOIs, SSRIs, tramadol, or other serotonergic drugs. The classic triad: neuromuscular changes (tremor, muscle twitching, clonus), autonomic instability (rapid heart rate, fever, sweating), and altered mental status (agitation, confusion). Severe cases involve high fever, seizures, and organ failure. If you see clonus or a high fever alongside MDMA use, treat it as a medical emergency."
            }
          },
          {
            "@type": "Question",
            "name": "What is HPPD?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Hallucinogen Persisting Perception Disorder (HPPD) is a condition where visual disturbances from psychedelic use persist after the drug wears off, visual snow, trailing afterimages, halos, or geometric patterns. It's rare but real. Risk factors include high doses, frequent use, pre-existing anxiety, and cannabis use during or after. Cannabis typically worsens it. There's no proven treatment, see a neurologist or psychiatrist familiar with the condition if you experience persistent visual changes."
            }
          },
          {
            "@type": "Question",
            "name": "Does MDMA cause brain damage? What about 'holes in your brain'?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The 'holes in your brain' claim originated from a retracted 2002 Science paper (Ricaurte et al.), withdrawn after subjects were accidentally given methamphetamine, not MDMA, due to mislabeled vials. Current evidence shows serotonin transporter (SERT) reductions in heavy users with 50+ lifetime sessions (Erritzoe et al. 2011, PMID 21646575), but no neuroimaging evidence of lasting damage in moderate users with fewer than 50 sessions (Müller et al. 2016, PMID 26746590). Szigeti et al. 2018 (PMID 29733742) found that neuroimaging study populations use MDMA at 720% higher rates than typical users, heavy-user findings don't generalize. Real serotonergic neurotoxicity risk exists for frequent high-dose users; the dopaminergic 'holes in the brain' claim was based on a scientific error that has since been retracted."
            }
          },
          {
            "@type": "Question",
            "name": "Can benzodiazepines stop a bad psychedelic trip? What are 'trip killers'?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, benzodiazepines (diazepam, lorazepam) are the clinical standard for managing acute adverse psychedelic reactions. They enhance GABA activity, significantly reducing anxiety without fully stopping the experience. MAPS MDMA-assisted therapy protocols and psilocybin clinical trials specify benzodiazepines as the primary emergency rescue medication (Breeksema et al. 2022, PMID 36017784). Avoid antipsychotics (haloperidol, quetiapine) as first-line, literature suggests they can worsen dysphoria in psychedelic contexts. Never combine benzodiazepines with alcohol. A moderate dose typically takes effect in 30–60 minutes. The Fireside Project (62-FIRESIDE) offers free peer support during crises."
            }
          },
          {
            "@type": "Question",
            "name": "Can you fatally overdose on mushrooms or LSD?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Classic psychedelics (psilocybin, LSD) have extremely high physiological safety margins. No verified human deaths from direct psilocybin or LSD toxicity have been documented at recreational doses. Gable 2004 (Addiction, PMID 15139867) ranked both among the lowest of all commonly used substances on physiological lethal risk, with safety ratios estimated around 1,000:1. The critical distinction: NBOMe compounds sold as 'acid' on blotter ARE lethal at recreational doses and have caused documented fatalities. Testing with Ehrlich Reagent before use is essential, NBOMes cause mouth numbness and a chemical taste; genuine LSD is tasteless. Real indirect risks include behavioral accidents while impaired and psychological crises at high doses."
            }
          },
          {
            "@type": "Question",
            "name": "Is combining MDMA and cocaine dangerous?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, this combination carries serious cardiovascular risk that is greater than either drug alone. Both are stimulants: MDMA floods synapses with serotonin and norepinephrine; cocaine blocks reuptake of dopamine and norepinephrine. Combined cardiovascular effects are additive: simultaneous elevation of heart rate, blood pressure, and body temperature. There is also a pharmacokinetic interaction: cocaine inhibits CYP2D6, the liver enzyme that metabolizes MDMA, potentially raising MDMA blood levels and extending its duration unpredictably. Cocaine also blocks cardiac sodium channels, adding arrhythmia risk. This is a common festival combination whose risks are poorly understood by most users."
            }
          },
          {
            "@type": "Question",
            "name": "Does nitrous oxide damage your nervous system? What about vitamin B12?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Nitrous oxide irreversibly inactivates vitamin B12 by oxidizing its cobalt center, blocking two enzymatic pathways required for myelin synthesis. With frequent or heavy use, B12 stores deplete. Consequences include subacute combined degeneration (SCD) of the spinal cord, irreversible demyelination causing progressive numbness, weakness, and balance problems if not caught early (Thayabaran et al. 2021, PMID 33590530). Normal serum B12 tests can miss this, functional markers (methylmalonic acid, homocysteine) rise before symptoms appear. Vegans and vegetarians with lower baseline B12 are at higher risk. The 'dentists use it safely' logic doesn't apply, clinical dental use is brief and controlled, not dozens of cartridges per session."
            }
          },
          {
            "@type": "Question",
            "name": "Do LSD and psilocybin cause cross-tolerance with each other?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, classic serotonergic psychedelics (LSD, psilocybin, mescaline, 2C-B) produce rapid cross-tolerance because they all work via 5-HT2A receptor agonism, which triggers receptor downregulation. Taking psilocybin within days of LSD produces a substantially blunted effect, and vice versa. Tolerance develops within 3–4 days of repeated use and resolves over roughly 1–2 weeks of abstinence (Nichols 2016, Pharmacological Reviews, PMID 26841800). This is the pharmacological basis for spacing experiences by at least 2 weeks, using sooner doesn't just produce a weaker experience, it renders the tolerance risk meaningless. MDMA tolerance operates through a completely different mechanism and is independent of psychedelic tolerance."
            }
          },
          {
            "@type": "Question",
            "name": "How much MDMA is a safe dose?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "MAPS Phase 3 clinical trials used 80–120 mg as therapeutic doses. Harm reduction guidance suggests 75–125 mg for recreational use, with 1–1.5 mg/kg body weight as a rough guideline. Lower doses carry less cardiovascular and neurotoxicity risk, the dose-response curve for adverse effects is non-linear. Pressed pills cannot be trusted for dose accuracy; always test with reagent kits and fentanyl test strips before dosing. See our full MDMA dosing guide for body-weight tables and redosing rules."
            }
          },
          {
            "@type": "Question",
            "name": "Is it safe to take Xanax or a benzodiazepine to sleep after rolling?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Once MDMA has substantially cleared, approximately 18–24 hours after your last dose, a single low-dose benzo carries relatively low direct pharmacological interaction risk, provided no GHB or opioids are present. The main dangers are: accidental redosing because MDMA impairs memory, respiratory depression if any GHB or opioids are on board, and dependency risk with regular use. GHB to sleep after stimulants is dangerous and has caused fatalities, avoid. These timing windows are pharmacokinetically inferred, not RCT-validated."
            }
          },
          {
            "@type": "Question",
            "name": "Why is mixing GHB and alcohol so dangerous?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "GHB and alcohol both depress the central nervous system via overlapping GABA pathways, producing synergistic rather than additive CNS and respiratory depression. GHB has an extremely narrow therapeutic window, roughly 2–3x between a euphoric dose and a coma-inducing one. A Euro-DEN registry study found alcohol co-ingestion doubled ICU admission rates in GHB overdose (Galicia et al. 2019, PMID 31301370). The specific rave danger is 'gap drinking': people drink alcohol between GHB doses, then the next GHB dose hits alongside significant alcohol, pushing past the overdose threshold silently."
            }
          },
          {
            "@type": "Question",
            "name": "Can you use poppers with Viagra or Cialis?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No, this combination can be fatal. Poppers (alkyl nitrites) and PDE5 inhibitors like sildenafil (Viagra) and tadalafil (Cialis) both produce vasodilation through the nitric oxide / cGMP pathway. Combined, they cause synergistic hypotension that can drop blood pressure to life-threatening levels. Tadalafil has a 17.5-hour half-life, even taking poppers many hours after Cialis carries significant risk. This combination is absolutely contraindicated regardless of timing or dose."
            }
          },
          {
            "@type": "Question",
            "name": "What is cocaethylene and why is mixing cocaine and alcohol dangerous?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Cocaethylene is a unique compound formed only when cocaine and alcohol are both present in the liver. It is pharmacologically similar to cocaine but accumulates with repeated combined use and is more cardiotoxic. A 2023 prospective cohort study found cocaine + alcohol users had 12.6x higher odds of cardiac arrest in the ED vs cocaine alone (Shastry et al., PMID 36000306). Alcohol also masks cocaine intoxication, causing people to drink more than intended, a trap that amplifies risk."
            }
          },
          {
            "@type": "Question",
            "name": "Can you take LSD or psychedelics while on lithium?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Combining lithium with LSD, psilocybin, or other classic psychedelics is associated with seizures and is treated as an absolute contraindication. An analysis of online experience reports found roughly 47% of lithium-plus-psychedelic combinations involved a seizure, while none of the reports involving the mood stabilizer lamotrigine did (Nayak et al. 2021, PMID 34348413). Do not stop lithium on your own to use psychedelics; lithium discontinuation must be managed by a prescriber."
            }
          },
          {
            "@type": "Question",
            "name": "What is the difference between GHB and GBL?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "GBL is a prodrug that your body rapidly converts into GHB, so the active drug and the effects are the same. The practical difference is that GBL is more concentrated by volume, absorbs faster, and reaches the brain sooner, which makes it easier to overdose on and harder to dose accurately. GBL doses are smaller than GHB doses, so using a GHB measurement for GBL is a common and dangerous mistake."
            }
          },
          {
            "@type": "Question",
            "name": "Can you die from GHB?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. GHB has an unusually narrow window between a recreational dose and a coma-inducing one, roughly 2 to 3 times, so accidental overdose is common. The greatest danger is combining GHB or GBL with alcohol or other depressants, which sharply raises the risk of unconsciousness, stopped breathing, and death. Signs of overdose include sudden unresponsiveness, slow or absent breathing, and vomiting while unconscious; place the person on their side and call 911 immediately."
            }
          },
          {
            "@type": "Question",
            "name": "Do ketamine vapes actually contain ketamine?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Usually not. Ketamine hydrochloride, the powder form sold on the street, has a boiling point around 364C, while vape pens run at 200 to 250C, so it does not vaporize efficiently and partially degrades. Products sold informally as ketamine vapes more often contain novel dissociative research chemicals such as 2-fluorodeschloroketamine (2-FDCK), deschloroketamine (DCK), or methoxetamine (MXE), which are easier to vaporize but have thinner safety data and documented fatalities. There is no dose control or purity data, and reagent kits cannot reliably distinguish ketamine from its analogs in a vape; only lab-based drug checking (FTIR or GC/MS) can identify the contents."
            }
          },
          {
            "@type": "Question",
            "name": "What is levamisole in cocaine?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Levamisole is a veterinary deworming drug found in roughly 70 to 80% of US cocaine, used as a cutting agent. In a subset of people it triggers an immune reaction that destroys infection-fighting white blood cells (agranulocytosis), which can be fatal, and it can also cause a skin vasculitis. You cannot detect it by sight or taste. Warning signs after cocaine use include persistent fever, mouth or skin ulcers, and infections that will not clear; seek medical care and tell the clinician you used cocaine (Larocque and Hoffman 2012, PMID 22677078)."
            }
          },
          {
            "@type": "Question",
            "name": "Do earplugs ruin the music at a rave?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Cheap foam earplugs sound muffled because they cut high frequencies far more than low ones, but high-fidelity (filtered) earplugs lower the volume evenly across the spectrum, so the music stays clear, just quieter. A randomized trial of festival-goers found earplug users had far less temporary hearing loss and tinnitus afterward (Ramakers et al. 2016, PMID 27054284). You still feel the bass, which travels through your body as well as your ears."
            }
          },
          {
            "@type": "Question",
            "name": "Can one loud night cause permanent hearing loss?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. At the 100 to 110 dB levels typical of raves, the safe exposure window is only minutes, and a single intense exposure can cause permanent acoustic trauma. Even a night that leaves only temporary ringing can permanently destroy inner-ear nerve connections: research found exposures causing only temporary threshold shifts still killed up to 40% of cochlear nerve synapses (Kujawa and Liberman 2009, PMID 19906956). Earplugs are the only reliable protection."
            }
          },
          {
            "@type": "Question",
            "name": "Do your ears toughen up to loud music?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. When a loud venue starts sounding quieter or more comfortable, that is a temporary threshold shift, your inner ear fatiguing and partly shutting down under overload, not adaptation or resilience. The recovery over the next day or two hides permanent loss of auditory nerve connections. People who tolerate very loud venues usually have hearing loss that has erased the protective discomfort. The only protection is limiting the dose with earplugs, distance, and breaks."
            }
          },
          {
            "@type": "Question",
            "name": "Can GHB cause seizures?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. The most dangerous GHB seizures occur during withdrawal in dependent users: GHB constantly activates GABA-B receptors, the brain downregulates that inhibitory system, and abrupt cessation leaves nothing to dampen excitation, which can trigger seizures within 1 to 6 hours of the last dose and cluster in the first 24 to 48 hours. A heavy GHB overdose can also cause seizure-like jerking (myoclonus) as the person loses consciousness. Both are medical emergencies: do not restrain the person, roll them onto their side once jerking stops, and call emergency services, mentioning GHB or GBL."
            }
          },
          {
            "@type": "Question",
            "name": "Does LSD stay in your spine or body?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. LSD does not accumulate in the spine, spinal fluid, or fat. It has a plasma half-life of roughly 3 to 4 hours, is extensively metabolized in the liver to inactive metabolites, and well under 1% is excreted unchanged. It is essentially cleared from the body within about a day. Flashbacks and HPPD are real but are not caused by stored drug being released later; the basis is neural, not a tissue reservoir."
            }
          },
          {
            "@type": "Question",
            "name": "Is microdosing safe long-term?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Short-term microdosing appears low-risk, but long-term human safety data is lacking. The main theoretical concern is heart-valve disease (valvulopathy) from repeated activation of the 5-HT2B receptor, the same mechanism behind valve damage from fen-phen and some Parkinson's drugs. LSD and psilocin are 5-HT2B agonists, and cumulative exposure from frequent microdosing is pharmacologically different from a single full dose. No human cases have been reported yet, but people with existing valve disease should be especially cautious."
            }
          },
          {
            "@type": "Question",
            "name": "Does ketamine cause brain damage or memory loss?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "It depends on how much and how often. Occasional or medically supervised use shows little evidence of lasting brain damage. Frequent, heavy recreational use is associated with real, dose-related cognitive impairment, especially episodic and working memory, shown in longitudinal studies of frequent users. Acute ketamine also disrupts memory while you are under its effects. The better-established chronic harm from heavy use is bladder and urinary-tract damage."
            }
          },
          {
            "@type": "Question",
            "name": "How long does MDMA stay in your system?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "MDMA is typically detectable in urine for about 1 to 3 days after a single use, in blood and saliva for roughly 1 to 2 days, and in hair for up to about 90 days. Sensitive lab testing that targets the metabolite HMMA can extend the urine window to 5 to 6 days. This is separate from how long the effects last (3 to 5 hours). Note that a standard 5-panel drug test does not reliably detect MDMA; it needs an MDMA-specific assay or confirmatory lab analysis."
            }
          },
          {
            "@type": "Question",
            "name": "Does weed make a psychedelic trip stronger or worse?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "It is unpredictable. Cannabis usually intensifies the visual and headspace effects of LSD or psilocybin, and at higher doses it is anxiety-provoking, so for less experienced users it more often tips a trip toward panic than calms it. Survey data shows co-users report both tension reduction and increased anxiety. Timing matters most: the peak is the riskiest moment to add cannabis, while a small amount on the tail end is lower-risk. Cannabis also worsens HPPD. Beginners should not combine them."
            }
          }
        ]
      }
    ]
  }`;
