---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => p.data.author === 'Jordan Mercer')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title       = `Jordan Mercer — Harm Reduction Writer | Rave Wellness`;
const description = `Jordan Mercer is a harm reduction writer and drug checking advocate covering psychedelics, stimulants, and festival safety at Rave Wellness.`;
const canonical   = `https://www.ravewellness.org/author/jordan-mercer.html`;

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.ravewellness.org/author/jordan-mercer.html#person",
      "name": "Jordan Mercer",
      "url": canonical,
      "jobTitle": "Harm Reduction Writer",
      "description": "Harm reduction writer covering rave and festival drug safety, including psychedelics, stimulants, dissociatives, and adulterant testing.",
      "knowsAbout": ["Harm reduction", "MDMA", "Psychedelics", "LSD", "Psilocybin", "Ketamine", "GHB", "Cocaine", "Drug checking", "Fentanyl test strips", "Serotonin syndrome", "Festival safety", "Noise-induced hearing loss"],
      "worksFor": {
        "@type": "Organization",
        "name": "Rave Wellness",
        "url": "https://www.ravewellness.org"
      }
    },
    {
      "@type": "ProfilePage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": title,
      "description": description,
      "about": { "@id": "https://www.ravewellness.org/author/jordan-mercer.html#person" }
    }
  ]
});
---

<BaseLayout {title} {description} {canonical} {schemaJson}>
  <Fragment slot="footer-nav">
    <h4>Browse</h4>
    <a href="/blog.html">All articles</a>
    <a href="/#guides">Drug guides</a>
    <a href="/interactions.html">Interaction checker</a>
  </Fragment>

  <main>
    <section id="hero" style="padding-top: 72px; padding-bottom: 48px;">
      <div class="container">
        <div style="max-width: 760px; margin: 0 auto;">
          <a href="/blog.html" style="color: var(--text-muted); font-size: 0.85rem; text-decoration: none; display: inline-block; margin-bottom: 24px;">← All articles</a>
          <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 24px;">
            <div style="width: 72px; height: 72px; border-radius: 50%; background: color-mix(in srgb, var(--purple) 15%, transparent); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <span style="font-size: 1.8rem; font-weight: 700; color: var(--purple);">JM</span>
            </div>
            <div>
              <h1 style="font-size: 1.8rem; font-weight: 700; margin: 0 0 4px;">Jordan Mercer</h1>
              <p style="color: var(--text-muted); margin: 0; font-size: 0.95rem;">Harm Reduction Writer</p>
            </div>
          </div>
          <p style="color: var(--text-muted); line-height: 1.75; max-width: 640px;">
            Jordan Mercer is a harm reduction writer covering rave and festival drug safety. The work focuses on psychedelics, stimulants, dissociatives, and the adulterants that turn up in all of them. Articles are grounded in clinical research and written for people who want straight information, not lectures.
          </p>
        </div>
      </div>
    </section>

    <section style="padding-bottom: 80px;">
      <div class="container">
        <div style="max-width: 760px; margin: 0 auto;">
          <h2 style="font-size: 1.2rem; font-weight: 600; margin-bottom: 24px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Articles by Jordan Mercer</h2>
          <div style="display: flex; flex-direction: column; gap: 0;">
            {posts.map((post, i) => (
              <a
                href={`/blog/${post.id}.html`}
                style={`display: block; padding: 20px 0; border-bottom: 1px solid var(--border); text-decoration: none; ${i === 0 ? 'border-top: 1px solid var(--border);' : ''}`}
              >
                <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 6px;">
                  {post.data.tags?.slice(0, 3).map(tag => (
                    <span class="research-tag tag-clinical" style="font-size: 0.75rem; padding: 2px 8px;">{tag}</span>
                  ))}
                </div>
                <h3 style="font-size: 1.05rem; font-weight: 600; color: var(--text); margin: 0 0 6px; line-height: 1.4;">{post.data.title}</h3>
                <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0 0 8px; line-height: 1.5;">{post.data.description}</p>
                <span style="color: var(--text-muted); font-size: 0.8rem;">
                  {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
