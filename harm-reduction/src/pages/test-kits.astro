---
import BaseLayout from '../layouts/BaseLayout.astro';

const title       = `How to Use Fentanyl Test Strips and Reagent Kits | Rave Wellness`;
const description = `Video walkthroughs for fentanyl test strips (BTNX), xylazine strips, and Marquis/Ehrlich reagents, with DanceSafe written references to cross-check your technique.`;
const keywords    = `how to use fentanyl test strips, reagent test kit tutorial, marquis reagent how to, dance safe testing, BTNX test strips, drug checking harm reduction`;
const canonical   = `https://www.ravewellness.org/test-kits.html`;
const ogTitle     = `How to Use Fentanyl Test Strips and Reagent Kits | Rave Wellness`;
const ogDesc      = `Step-by-step videos for BTNX fentanyl strips, xylazine strips, and reagent test kits. Manufacturer demos and community-oriented harm reduction technique.`;
const twTitle     = ``;
const twDesc      = ``;
const schemaJson  = `{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "@id": "https://www.ravewellness.org/test-kits.html#article",
        "headline": "How to Use Drug Test Kits, Video Tutorials",
        "url": "https://www.ravewellness.org/test-kits.html",
        "author": { "@type": "Organization", "name": "Rave Wellness", "url": "https://www.ravewellness.org" },
        "publisher": { "@type": "Organization", "name": "Rave Wellness", "url": "https://www.ravewellness.org" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ravewellness.org/" },
          { "@type": "ListItem", "position": 2, "name": "Test kit videos", "item": "https://www.ravewellness.org/test-kits.html" }
        ]
      },
      {
        "@type": "VideoObject",
        "name": "How to Use Fentanyl Test Strips, BTNX Manufacturer Demo",
        "description": "Step-by-step manufacturer demonstration of BTNX fentanyl test strips: liquid preparation, dip timing, and reading the result line for accurate fentanyl detection.",
        "thumbnailUrl": "https://img.youtube.com/vi/hwF6986Sd3o/maxresdefault.jpg",
        "uploadDate": "2021-09-01",
        "embedUrl": "https://www.youtube.com/embed/hwF6986Sd3o",
        "url": "https://www.youtube.com/watch?v=hwF6986Sd3o"
      },
      {
        "@type": "VideoObject",
        "name": "Fentanyl Test Strips, Community Harm Reduction Guide (DanceSafe)",
        "description": "DanceSafe's community-oriented walkthrough for using fentanyl test strips at home or in a hotel room, with practical framing for real-world harm reduction.",
        "thumbnailUrl": "https://img.youtube.com/vi/a_QLUwXQXEg/maxresdefault.jpg",
        "uploadDate": "2020-06-01",
        "embedUrl": "https://www.youtube.com/embed/a_QLUwXQXEg",
        "url": "https://www.youtube.com/watch?v=a_QLUwXQXEg"
      }
    ]
  }`;
---

<BaseLayout
  {title}
  {description}
  {keywords}
  {canonical}
  ogTitle={ogTitle}
  ogDescription={ogDesc}
  twitterTitle={twTitle}
  twitterDescription={twDesc}
  {schemaJson}
>
  <Fragment slot="footer-orgs">
    <a href="/store" target="_blank" rel="noopener">DanceSafe</a>
            <a href="https://maps.org" target="_blank" rel="noopener">MAPS</a>
            <a href="https://tripsit.me" target="_blank" rel="noopener">TripSit</a>
  </Fragment>
  <Fragment slot="footer-nav">
    <h4>Navigation</h4>
              <a href="/">Home</a>
              <a href="faq.html">FAQ</a>
              <a href="test-kits.html">Test kit videos</a>
              <a href="index.html#shop">Shop</a>
  </Fragment>

<main>
    <section id="hero" style="padding-top: 72px;">
      <div class="container">
        <div class="section-header" style="margin-bottom: 24px;">
          <div class="step-pill">Harm reduction skills</div>
          <h1>How to actually use test kits</h1>
          <p class="section-sub">Videos can’t replace reading your strip’s insert, always follow the brand-specific directions, but these walkthroughs show the core techniques used in community drug checking.</p>
        </div>
        <div class="during-warning" style="max-width: 720px; margin: 0 auto 40px;">
          <strong>Safety:</strong> Reagents are corrosive. Use gloves and eye protection, work in a ventilated space, and never touch the bottle tip to the sample. Strips and reagents reduce risk, they don’t make any drug “safe.”
        </div>

        <div class="video-embed-grid">
          <div>
            <div class="video-embed">
              <iframe src="https://www.youtube-nocookie.com/embed/hwF6986Sd3o" title="BTNX fentanyl test strip demonstration" allowfullscreen loading="lazy"></iframe>
            </div>
            <p class="video-embed-caption"><strong>Fentanyl strips (manufacturer demo).</strong> Liquid prep and timing vary by strip, check your package insert.</p>
          </div>
          <div>
            <div class="video-embed">
              <iframe src="https://www.youtube-nocookie.com/embed/a_QLUwXQXEg" title="DanceSafe fentanyl test strips" allowfullscreen loading="lazy"></iframe>
            </div>
            <p class="video-embed-caption"><strong>Community-oriented fentanyl strip guidance</strong> (DanceSafe). Helpful framing for real-world use at home or in a hotel room.</p>
          </div>
        </div>

        <div class="container" style="max-width: 720px; margin-top: 48px;">
          <h2 class="section-title" style="font-size: 1.5rem;" id="written-references-always-cross-check">Written references (always cross-check)</h2>
          <ul class="resource-list" style="margin-top: 16px;">
            <li><a href="/which-test-kit.html" class="supp-link">Which drug test kit do I need? Contents, prices, and limits compared</a></li>
            <li><a href="/reagent-chart.html" class="supp-link">Our reagent color chart, how to read every reagent result</a></li>
            <li><a href="/kits" target="_blank" rel="noopener">DanceSafe, Reagent kits (complete set)</a></li>
            <li><a href="https://harmreduction.org/what-is-harm-reduction/" target="_blank" rel="noopener">Harm Reduction Coalition, what is harm reduction</a></li>
            <li><a href="mdma.html#test" class="supp-link">Our MDMA testing section, protocol text</a></li>
            <li><a href="lsd.html#test" class="supp-link">Our LSD / Ehrlich testing section</a></li>
          </ul>
        </div>

        <div class="section-header" style="margin-top: 56px;">
          <h2 id="from-the-blog">From the Blog</h2>
          <p class="section-sub">Buying a kit, keeping it usable, and what a result actually proves.</p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 24px;">
          <a href="/blog/is-my-molly-real-or-fake.html" style="display: block; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; text-decoration: none;">
            <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--purple-light); margin-bottom: 8px;">MDMA</p>
            <h3 style="font-size: 1rem; color: var(--text); margin-bottom: 8px; line-height: 1.4;" id="is-my-molly-real-or-fake">Is My Molly Real or Fake?</h3>
            <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5;">Appearance, taste and smell answer nothing. Here is the reagent order that does.</p>
          </a>
          <a href="/blog/is-my-acid-real-or-nbome.html" style="display: block; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; text-decoration: none;">
            <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--purple-light); margin-bottom: 8px;">LSD</p>
            <h3 style="font-size: 1rem; color: var(--text); margin-bottom: 8px; line-height: 1.4;" id="is-my-acid-real-or-nbome">Is My Acid Real, or Is It NBOMe?</h3>
            <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5;">The bitter test is real but unusable, because running it is the exposure. Ehrlich is the answer.</p>
          </a>
          <a href="/blog/do-reagent-test-kits-expire.html" style="display: block; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; text-decoration: none;">
            <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--purple-light); margin-bottom: 8px;">Storage</p>
            <h3 style="font-size: 1rem; color: var(--text); margin-bottom: 8px; line-height: 1.4;" id="do-reagent-test-kits-expire">Do Reagent Test Kits Expire?</h3>
            <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5;">Darkening is expected and not the same as ruined. The endpoint is when you cannot read it.</p>
          </a>
          <a href="/blog/are-amazon-drug-test-kits-legit.html" style="display: block; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; text-decoration: none;">
            <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--purple-light); margin-bottom: 8px;">Buying</p>
            <h3 style="font-size: 1rem; color: var(--text); margin-bottom: 8px; line-height: 1.4;" id="are-amazon-kits-legit">Are Amazon Drug Test Kits Legit?</h3>
            <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5;">Provenance and freshness are the questions a marketplace listing rarely answers.</p>
          </a>
          <a href="/blog/is-it-legal-to-buy-a-drug-test-kit.html" style="display: block; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; text-decoration: none;">
            <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--purple-light); margin-bottom: 8px;">Legal</p>
            <h3 style="font-size: 1rem; color: var(--text); margin-bottom: 8px; line-height: 1.4;" id="is-it-legal-to-buy-a-kit">Is It Legal to Buy a Drug Test Kit?</h3>
            <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5;">Reagents are broadly legal. Fentanyl strip law varies by state and changed fast after 2021.</p>
          </a>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>