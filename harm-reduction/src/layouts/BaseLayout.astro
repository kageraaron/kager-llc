---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  schemaJson?: string;
}

const {
  title,
  description,
  keywords = '',
  canonical = '',
  ogTitle,
  ogDescription,
  ogType = 'article',
  twitterTitle,
  twitterDescription,
  schemaJson = '',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">

  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="Rave Wellness Blog" href="https://www.ravewellness.org/rss.xml" />

  <meta property="og:title" content={ogTitle || title} />
  <meta property="og:description" content={ogDescription || description} />
  <meta property="og:type" content={ogType} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="Rave Wellness" />
  <meta property="og:image" content="https://www.ravewellness.org/android-chrome-512x512.png" />
  <meta property="og:image:width" content="512" />
  <meta property="og:image:height" content="512" />
  <meta property="og:image:alt" content="Rave Wellness — harm reduction for the rave community" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://www.ravewellness.org/android-chrome-512x512.png" />
  <meta name="author" content="Rave Wellness" />

  {schemaJson && <script type="application/ld+json" set:html={schemaJson} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <meta name='impact-site-verification' value='52227644-d19a-41a7-a2e5-cc58f465b191'>
</head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-ES9Z0KYP85"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-ES9Z0KYP85');
</script>
<body>

  <a href="#main-content" class="skip-to-main">Skip to main content</a>
  <span id="main-content" tabindex="-1" aria-hidden="true"></span>

  <header id="site-header">
    <nav>
      <div class="nav-container">
        <a href="/" class="logo"><img src="/logo.svg" width="32" height="32" alt="" class="logo-mark" aria-hidden="true" />Rave<span>Wellness</span></a>
        <ul class="nav-links" id="nav-links">
          <li><a href="/">Home</a></li>
          <li class="nav-dropdown">
            <a href="/#guides">Guides <span class="nav-chevron">▾</span></a>
            <ul class="nav-dropdown-menu">
              <li><a href="/mdma.html">MDMA</a></li>
              <li><a href="/ketamine.html">Ketamine</a></li>
              <li><a href="/lsd.html">LSD</a></li>
              <li><a href="/psilocybin.html">Psilocybin</a></li>
              <li><a href="/nitrous.html">Nitrous Oxide</a></li>
              <li><a href="/cocaine.html">Cocaine &amp; Stimulants</a></li>
              <li><a href="/2cb.html">2C-B</a></li>
              <li><a href="/ghb.html">GHB / GBL</a></li>
              <li><a href="/poppers.html">Poppers</a></li>
              <li><a href="/test-kits.html">Test kit videos</a></li>
              <li><a href="/interactions.html">Interaction Checker</a></li>
              <li class="nav-dropdown-divider"></li>
              <li><a href="/hearing.html">Hearing Health</a></li>
            </ul>
          </li>
          <li><a href="/hearing.html">Hearing</a></li>
          <li><a href="/faq.html">FAQ</a></li>
          <li><a href="/blog.html">Blog</a></li>
          <li><a href="/#shop" class="nav-cta">Shop</a></li>
        </ul>
        <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
  </header>

  <slot />

  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo"><img src="/logo.svg" width="32" height="32" alt="" class="logo-mark" aria-hidden="true" />Rave<span>Wellness</span></a>
          <p>Evidence-based harm reduction for the rave community.</p>
          <div style="margin: 10px 0 12px;">
            <a href="https://www.instagram.com/ravewellnessorg/" target="_blank" rel="noopener" aria-label="Rave Wellness on Instagram" style="color: var(--text-muted); text-decoration: none; font-size: 0.85rem;">Instagram: @RaveWellnessOrg</a>
          </div>
          <div class="footer-orgs">
            <slot name="footer-orgs">
              <a href="https://dancesafe.org/r/ravewellness/" target="_blank" rel="noopener">DanceSafe</a>
              <a href="https://maps.org" target="_blank" rel="noopener">MAPS</a>
              <a href="https://tripsit.me" target="_blank" rel="noopener">TripSit</a>
            </slot>
          </div>
        </div>
        <div class="footer-nav">
          <slot name="footer-nav" />
        </div>
        <div class="footer-emergency">
          <slot name="footer-emergency">
            <h4>Emergency</h4>
            <p>Overdose or medical emergency: call local emergency services. Administer naloxone if opioids may be involved.</p>
          </slot>
        </div>
      </div>
      <div class="footer-disclaimer">
        <slot name="footer-disclaimer">
          <p><strong>Disclaimer:</strong> This website provides harm reduction information for educational purposes only. Nothing here constitutes medical advice. Many substances discussed are controlled and illegal in most jurisdictions. This site neither condones nor encourages illegal activity. Affiliate links (including DanceSafe referral links) help support this resource — all recommendations are based solely on harm reduction value.</p>
        </slot>
      </div>
      <p class="footer-copy">© 2026 Rave Wellness · www.ravewellness.org · All rights reserved. · <a href="/contact.html" style="color: inherit; text-decoration: underline;">Contact</a> · <a href="/privacy.html" style="color: inherit; text-decoration: underline;">Privacy Policy</a> · <a href="/terms.html" style="color: inherit; text-decoration: underline;">Terms of Use</a></p>
    </div>
  </footer>

  <script defer src="/script.js"></script>
</body>
</html>
