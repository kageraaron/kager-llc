# Printify integration (server-only — never expose to client)
# Example only - do not provide values or commit to this file.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Optional: override the default Printify API base URL (sandbox vs production)
# PRINTIFY_API_BASE=https://api.printify.com/v1

# Printful integration (server-only)
PRINTFUL_API_TOKEN=
# Required for multi-store accounts; leave blank for single-store accounts.
PRINTFUL_STORE_ID=
# Optional override.
# PRINTFUL_API_BASE=https://api.printful.com

# Customer-facing markup applied to Printful base prices.
# 0.20 = 20% (default). Exposed to client for price display.
NEXT_PUBLIC_PRINTFUL_MARKUP=0.20

# Stripe Checkout (server-only). Without these, Printful orders fall back
# to draft mode and no payment is captured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public site URL — used to build Stripe success/cancel return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Google AdSense publisher id (e.g. ca-pub-XXXXXXXXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Slot id used by the in-editor AdSlot during long-running jobs.
NEXT_PUBLIC_ADSENSE_PROCESSING_SLOT=
