# ---------- Supabase ----------
# NOTE: projects created after Nov 2025 no longer issue anon/service_role keys.
# Dashboard -> Project Settings -> API Keys:
#   "Publishable" (sb_publishable_...) -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   "Secret"      (sb_secret_...)      -> SUPABASE_SERVICE_ROLE_KEY
# The variable names below keep the old wording; only the key values changed.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — bypasses RLS, never expose to the client

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adds a password field to the login page so the seeded test accounts in
# supabase/seed.sql are reachable (a magic link to demo@stub.local goes
# nowhere). LOCAL ONLY — omit in production, where sign-in stays Google-only.
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=false

# 32-byte key, base64. Encrypts stored OAuth tokens at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---------- Concert data ----------
# Free, instant: https://developer.ticketmaster.com  (5000 calls/day, 5 req/s)
TICKETMASTER_API_KEY=
# Free for non-commercial: https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=
# JamBase — aggregated live-music listings. Broader indie/club coverage than
# Ticketmaster, which only knows about events it sells tickets to.
# https://www.jambase.com/developer
JAMBASE_API_KEY=
# Spotify concert graph via the spotify81 RapidAPI proxy. The best ARTIST search
# available here: it matches partial names ("Chris L" -> Chris Lake) and resolves
# to a canonical Spotify artist rather than a tribute act. It has no location
# search at all, so JamBase still serves "what's on near me".
# FREE PLAN IS 1000 REQUESTS PER MONTH — the tightest limit of any provider here,
# which is why every call goes through the 6-hour cache in lib/cache.ts.
# https://rapidapi.com/  (subscribe to the "Spotify" / spotify81 API)
RAPID_API_KEY=

# Bandsintown, via a Parse (parse.bot) generated API. The MOST ACCURATE source
# here for club shows — it has Overmono @ Public Works, SF, which Ticketmaster
# and JamBase both miss — and the only one that reports a real IANA timezone or
# an artist's PAST tour dates.
#
# ALSO THE SCARCEST BY FAR. Parse Free is 200 credits PER MONTH — about 6.6 a
# day — at one credit per artist query. That is roughly 5x tighter than the
# RapidAPI Spotify quota and four orders of magnitude tighter than Ticketmaster.
# It is therefore LAST in the ingestion cascade and never on the Browse keystroke
# path; Browse reaches it only behind the explicit "Search harder" button.
# Paid tiers if this runs short: Hobby $30/mo = 1,000 credits,
# Developer $100/mo = 5,000.
# Key: https://parse.bot/settings
PARSE_API_KEY=
# The REAL ceiling — the monthly quota, enforced in lib/cache.ts before each
# call. Defaults to 180 against a real 200, leaving ~10% headroom because Parse
# resets on its own clock and our month boundary is UTC.
BANDSINTOWN_MONTHLY_CREDITS=180
# A burst limiter, not a budget: stops one runaway afternoon consuming the month
# in an hour. Deliberately above 200/30, because real usage is lumpy and a hard
# 6/day would refuse the second genuine search of an evening.
BANDSINTOWN_DAILY_CREDITS=25
# Deep searches ("Search harder") per user per 24h. The global caps stop the
# deployment overspending; this stops ONE person spending everyone's month.
# Cache hits do not count — nothing is spent, so nothing is charged.
BANDSINTOWN_DEEP_PER_USER=5
# Pin a marketplace release so an upstream update cannot change the response
# shape under us. Current: 17.
BANDSINTOWN_API_VERSION=17
# Override only to point at a private Parse fork of the listing.
# BANDSINTOWN_SCRAPER_ID=25ccb7dd-ea12-4f2c-bb0a-966dbe1228e3

# MusicBrainz requires a descriptive User-Agent, no key.
MUSICBRAINZ_USER_AGENT=Stub/0.1.0 ( you@example.com )

# Nominatim (OpenStreetMap) geocoding requires a descriptive User-Agent, no key.
# Hard limit of 1 request/second; results are cached for 30 days.
NOMINATIM_USER_AGENT=Stub/0.1.0 ( you@example.com )

# ---------- Sign-in (Google is primary; configured in Supabase dashboard) ----------
# Google Cloud OAuth client, kept in OAuth "Testing" mode = up to 100 test users,
# which is what lets us use the restricted gmail.readonly scope with no CASA review.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- Optional per-user connections ----------
# NOTE: as of Feb 2026 a Spotify development-mode app is capped at 5 authorized users
# and requires the developer to hold Premium. Not usable for sign-in — import only.
# Two independent uses, one app:
#
#  1. ARTIST METADATA (client credentials) — canonical artwork and genres for
#     artists, keyed on the Spotify artist id the concerts provider gives us.
#     This is the only source of artwork for a club-circuit act. Needs NOTHING
#     but the id and secret: no redirect URI, no user consent, no user cap.
#
#  2. "Import my favourite artists" (authorization code) — per-user, optional,
#     and hard-capped at FIVE allowlisted users by Spotify's development mode.
#     Only this one needs a redirect URI registered on the app:
#         http://127.0.0.1:3000/api/connect/spotify/callback   (local)
#         https://<your-domain>/api/connect/spotify/callback   (deployed)
#
# Leave both blank and the app degrades cleanly: no enrichment, no import.
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------- Eventbrite (free: 2,000 requests/hour) ----------
# A personal API key from https://www.eventbrite.com/platform/api-keys — the
# "private token". Used to resolve the event id carried in an Eventbrite
# confirmation email into the authoritative event: real name, real IANA
# timezone, venue with coordinates, artwork. First in the matcher cascade
# because it is first-party to the ticket and effectively free, but it only
# fires when an email actually carries an Eventbrite link.
#
# NOTE: public event SEARCH (/v3/events/search/) was withdrawn by Eventbrite and
# returns 404, so this cannot answer "what's on near me" and is not in Browse.
EVENTBRITE_API_KEY=

# ---------- Ingestion ----------
CRON_SECRET=                        # Vercel Cron auth header
INGEST_WEBHOOK_SECRET=              # shared HMAC secret with the Cloudflare Email Worker

# Forward-to-inbox is built but switched off until a domain is on Cloudflare.
FEATURE_FORWARD_INBOX=false
INBOUND_EMAIL_DOMAIN=in.example.com

# ---------- Not built (require Apple Developer Program, $99/yr) ----------
# APPLE_TEAM_ID=
# APPLE_MUSIC_KEY_ID=

# ---------- Web push (day-before show reminders) ----------
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The contact address push services use to reach the OPERATOR when an app's
# pushes misbehave. It is sent with every push, so prefer a role address on the
# app's own domain (mailto:push@yourdomain) over anyone's personal inbox.
#
# It must still be a real, monitored mailbox: Apple REJECTS a placeholder, so an
# unset or fake value means iOS pushes fail silently while Android and desktop
# work — a failure that looks like a device bug rather than a config one.
# See TODO §1.4; the role address is blocked on buying a domain.
VAPID_SUBJECT=mailto:push@yourdomain.example

# ---------- TRMNL e-ink display ----------
# Nothing to set. The TRMNL plugin uses the "Polling" strategy: TRMNL fetches
# /api/trmnl/<token> on its own schedule, and the per-user token in that URL is
# the only credential involved. Stub never calls TRMNL's API, so no TRMNL key
# belongs in this file — a user-level key (`user_…`) authenticates the Devices,
# Playlists and Plugin Settings management API, which this integration does not
# touch. See docs/trmnl/README.md.
