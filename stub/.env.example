# ---------- Supabase ----------
# NOTE: projects created after Nov 2025 no longer issue anon/service_role keys.
# Dashboard -> Project Settings -> API Keys:
#   "Publishable" (sb_publishable_...) -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   "Secret"      (sb_secret_...)      -> SUPABASE_SERVICE_ROLE_KEY
# The variable names below keep the old wording; only the key values changed.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — bypasses RLS, never expose to the client

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adds a password field to the login page so the seeded test accounts in
# supabase/seed.sql are reachable (a magic link to demo@stub.local goes
# nowhere). LOCAL ONLY — omit in production, where sign-in stays Google-only.
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=false

# 32-byte key, base64. Encrypts stored OAuth tokens at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---------- Concert data ----------
# Free, instant: https://developer.ticketmaster.com  (5000 calls/day, 5 req/s)
TICKETMASTER_API_KEY=
# Free for non-commercial: https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=
# JamBase — aggregated live-music listings. Broader indie/club coverage than
# Ticketmaster, which only knows about events it sells tickets to.
# https://www.jambase.com/developer
JAMBASE_API_KEY=

# MusicBrainz requires a descriptive User-Agent, no key.
MUSICBRAINZ_USER_AGENT=Stub/0.1.0 ( you@example.com )

# ---------- Sign-in (Google is primary; configured in Supabase dashboard) ----------
# Google Cloud OAuth client, kept in OAuth "Testing" mode = up to 100 test users,
# which is what lets us use the restricted gmail.readonly scope with no CASA review.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- Optional per-user connections ----------
# NOTE: as of Feb 2026 a Spotify development-mode app is capped at 5 authorized users
# and requires the developer to hold Premium. Not usable for sign-in — import only.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------- Ingestion ----------
CRON_SECRET=                        # Vercel Cron auth header
INGEST_WEBHOOK_SECRET=              # shared HMAC secret with the Cloudflare Email Worker

# Forward-to-inbox is built but switched off until a domain is on Cloudflare.
FEATURE_FORWARD_INBOX=false
INBOUND_EMAIL_DOMAIN=in.example.com

# ---------- Not built (require Apple Developer Program, $99/yr) ----------
# APPLE_TEAM_ID=
# APPLE_MUSIC_KEY_ID=

# ---------- Web push (day-before show reminders) ----------
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
